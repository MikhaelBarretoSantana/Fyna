# ============================================
# Fyna — Variáveis de ambiente do docker-compose
# Copie esse arquivo para .env e ajuste os valores
# ============================================

# ── Banco de dados (PostgreSQL local na máquina host) ────────
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=fyna_db
DB_USERNAME=postgres
DB_PASSWORD=change-me-strong-password

# ── Portas expostas ──────────────────────────────────────────
BACKEND_PORT=8080
FYNA_AI_PORT=8081

# ── Chaves internas e segurança ──────────────────────────────
# Chave compartilhada entre Spring Boot e fyna-ai (validação X-Internal-Key)
# Em produção: gerar com `openssl rand -hex 32`
FYNA_INTERNAL_KEY=change-me-internal-shared-secret

# JWT — precisa ter >= 256 bits (32 chars). Gerar com `openssl rand -hex 32`
JWT_SECRET=change-me-jwt-secret-must-be-at-least-256-bits-long

# ── CORS — origens permitidas (separadas por vírgula) ────────
FYNA_CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:4200

# ── Ambiente ─────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
FYNA_AI_DEBUG=true
