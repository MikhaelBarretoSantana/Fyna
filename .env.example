# ============================================
# Fyna — Variáveis de ambiente do docker-compose
# Copie esse arquivo para .env e ajuste os valores
# ============================================

# ── Banco de dados (PostgreSQL local na máquina host) ────────
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=fyna_db
DB_USERNAME=postgres
DB_PASSWORD=change-me-strong-password

# ── Portas expostas ──────────────────────────────────────────
BACKEND_PORT=8080
FYNA_AI_PORT=8081

# ── Chaves internas e segurança ──────────────────────────────
# Chave compartilhada entre Spring Boot e fyna-ai (validação X-Internal-Key)
# Em produção: gerar com `openssl rand -hex 32`
FYNA_INTERNAL_KEY=change-me-internal-shared-secret

# JWT — precisa ter >= 256 bits (32 chars). Gerar com `openssl rand -hex 32`
JWT_SECRET=change-me-jwt-secret-must-be-at-least-256-bits-long

# ── CORS — origens permitidas (separadas por vírgula) ────────
# Inclua aqui o domínio do ngrok (https://...) para liberar o app físico
FYNA_CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:4200,https://SEU-DOMINIO.ngrok-free.dev

# ── ngrok ────────────────────────────────────────────────────
# Authtoken da sua conta: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=seu-authtoken-aqui
# Domínio estático reservado em https://dashboard.ngrok.com/domains
NGROK_DOMAIN=SEU-DOMINIO.ngrok-free.dev

# ── Ambiente ─────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
FYNA_AI_DEBUG=true
