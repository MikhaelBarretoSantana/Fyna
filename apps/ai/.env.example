# ============================================
# FYNA AI Engine — Environment Variables
# Copie este arquivo para .env e ajuste os valores
# ============================================

# PostgreSQL (mesma base do Spring Boot)
# Local: localhost | Docker: host.docker.internal
FYNA_AI_DATABASE_URL=postgresql://postgres:SENHA@localhost:5432/fyna_db

# Chave interna — deve ser IGUAL a fyna.ai.internal-api-key no Spring Boot
# Em produção use um valor aleatório seguro (ex: openssl rand -hex 32)
FYNA_AI_INTERNAL_API_KEY=troque-por-valor-seguro-em-producao

# Classifier (sentence-transformers)
FYNA_AI_CLASSIFIER_MODEL=paraphrase-multilingual-MiniLM-L12-v2
FYNA_AI_CLASSIFIER_CONFIDENCE_THRESHOLD=0.35

# Prediction
FYNA_AI_PREDICTION_MONTHS_HISTORY=6

# Pattern detection
FYNA_AI_PATTERN_MIN_SIGNIFICANCE=0.3
FYNA_AI_PATTERN_ANOMALY_Z_THRESHOLD=2.5

# Service
FYNA_AI_MODEL_VERSION=fyna-ai-v1.0
FYNA_AI_DEBUG=false
